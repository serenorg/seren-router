# Server
BIND_ADDRESS=0.0.0.0:8000

# Logging
# JSON logging is auto-enabled in Kubernetes (KUBERNETES_SERVICE_HOST detected)
RUST_LOG=seren_router=debug,tower_http=debug

# Local-only startup fallback for the copied template auth stub. M2 replaces
# this protected-route authentication with the Gateway's static bearer key.
SEREN_ROUTER_ALLOW_INSECURE_HEADER_AUTH=true

# Database
# Uncomment to enable database readiness checks.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb
