# Server
BIND_ADDRESS=0.0.0.0:8000

# Router
# Required. Inject the actual value from the deployment secret manager.
SEREN_ROUTER_GATEWAY_KEY=
SEREN_ROUTER_SIDECAR_URL=http://127.0.0.1:4000
SEREN_ROUTER_REGISTRY_PATH=registry/providers.yaml

# Logging
# JSON logging is auto-enabled in Kubernetes (KUBERNETES_SERVICE_HOST detected)
RUST_LOG=seren_router=debug,tower_http=debug

# Database
# Required. Startup connects and runs embedded migrations before listening.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seren_router
